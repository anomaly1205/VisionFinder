# Copy to backend/.env and adjust. backend/.env is gitignored.
# XAMPP MySQL default: user root, no password, port 3306.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/visionfinder?charset=utf8mb4
# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me
